#: .\courses\element_forms.py:298 .\courses\element_forms.py:861
msgid "Mark at least one blank with {{answer}} (use | for alternatives)."
msgstr ""
"Oznacz co najmniej jedną lukę jako {{odpowiedź}} (użyj | dla wariantów)."

#: .\courses\element_forms.py:312
msgid "Write the answer in double braces, e.g. {{42}}."
msgstr "Wpisz odpowiedź w podwójnym nawiasie klamrowym, np. {{42}}."

#: .\courses\element_forms.py:314
msgid ""
"Use exactly one answer in braces — alternatives separated by \"|\" are not "
"supported here."
msgstr ""
"Użyj dokładnie jednej odpowiedzi w nawiasie — alternatywy oddzielone znakiem "
"„|” nie są tu obsługiwane."

#: .\courses\element_forms.py:354
msgid "The answer must be a number (e.g. 42 or 3,14)."
msgstr "Odpowiedź musi być liczbą (np. 42 lub 3,14)."

#: .\courses\element_forms.py:364
msgid ""
"The answer has too many digits (at most 12 before and 8 after the decimal "
"point)."
msgstr "Odpowiedź ma za dużo cyfr (najwyżej 12 przed przecinkiem i 8 po)."

#: .\courses\element_forms.py:377
msgid "Enter a number (e.g. 3.14 or 3,14)."
msgstr "Wpisz liczbę (np. 3.14 lub 3,14)."

#: .\courses\element_forms.py:379 .\courses\element_forms.py:826
msgid "Tolerance cannot be negative."
msgstr "Tolerancja nie może być ujemna."

#: .\courses\element_forms.py:452
msgid "Mark the choice position with {{choice}} exactly once."
msgstr "Oznacz miejsce wyboru za pomocą {{choice}} dokładnie raz."

#: .\courses\element_forms.py:459
msgid "Options cannot be empty."
msgstr "Opcje nie mogą być puste."

#: .\courses\element_forms.py:461
msgid "Add at least two options."
msgstr "Dodaj co najmniej dwie opcje."

#: .\courses\element_forms.py:468 .\courses\element_forms.py:471
msgid "Select the correct option."
msgstr "Wybierz poprawną opcję."

#: .\courses\element_forms.py:574
#, python-format
msgid "Line %(n)d: mark each cycler with {{choice}} exactly once."
msgstr ""
"Wiersz %(n)d: oznacz każdy przełącznik za pomocą {{choice}} dokładnie raz."
"Wiersz %(n)d: oznacz każdy przełącznik za pomocą {{choice}} dokładnie raz."

#: .\courses\element_forms.py:581
msgid "Each cycler needs at least two options."
msgstr "Każdy przełącznik musi mieć co najmniej dwie opcje."

#: .\courses\element_forms.py:583
msgid "Select the correct option in every cycler."
msgstr "Wybierz poprawną opcję w każdym przełączniku."

#: .\courses\element_forms.py:585
msgid "Add at least one line."
msgstr "Dodaj co najmniej jeden wiersz."

#: .\courses\element_forms.py:587
msgid "Add at least one cycler with options."
msgstr "Dodaj co najmniej jeden przełącznik z opcjami."

#: .\courses\element_forms.py:708
msgid "Add at least two choices."
msgstr "Dodaj co najmniej dwie odpowiedzi."

#: .\courses\element_forms.py:711
msgid "Mark at least one choice correct."
msgstr "Zaznacz co najmniej jedną poprawną odpowiedź."

#: .\courses\element_forms.py:714
msgid "A single-choice question needs exactly one correct choice."
msgstr ""
"Pytanie jednokrotnego wyboru wymaga dokładnie jednej poprawnej odpowiedzi."

#: .\courses\element_forms.py:730
msgid "Optional — shown if the student gets this option wrong"
msgstr "Opcjonalne — pokazywane, gdy uczeń pomyli się na tej opcji"

#: .\courses\element_forms.py:777
msgid "Add at least one accepted answer."
msgstr "Dodaj co najmniej jedną akceptowaną odpowiedź."

#: .\courses\element_forms.py:803 .\courses\element_forms.py:816
msgid "That number is too long (at most 64 characters once normalised)."
msgstr "Ta liczba jest za długa (najwyżej 64 znaki po znormalizowaniu)."

#: .\courses\element_forms.py:807 .\courses\element_forms.py:828
msgid "Enter a number or fraction (e.g. 3.14, 3,14 or 3/2)."
msgstr "Wpisz liczbę lub ułamek (np. 3,14 lub 3/2)."

#: .\courses\element_forms.py:901
msgid "Mark at least one gap with {{token}}."
msgstr "Oznacz co najmniej jedną lukę za pomocą {{token}}."

#: .\courses\element_forms.py:908
msgid ""
"Each gap holds one token — use a single answer per {{…}}, not alternatives."
msgstr ""
"Każda luka mieści jeden token — podaj jedną odpowiedź w {{…}}, bez wariantów."

#: .\courses\element_forms.py:914
msgid "A token is too long (max 500 characters)."
msgstr "Token jest za długi (maks. 500 znaków)."

#: .\courses\element_forms.py:957
msgid "Add at least one pair."
msgstr "Dodaj co najmniej jedną parę."

#: .\courses\element_forms.py:1027 .\courses\element_forms.py:1154
msgid "Add at least one column."
msgstr "Dodaj co najmniej jedną kolumnę."

#: .\courses\element_forms.py:1072 .\courses\element_forms.py:1205
msgid "Add at least one row."
msgstr "Dodaj co najmniej jeden wiersz."

#: .\courses\element_forms.py:1075
msgid "Each row needs a correct column."
msgstr "Każdy wiersz musi mieć poprawną kolumnę."

#: .\courses\element_forms.py:1209
